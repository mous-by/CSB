APP_NAME=CSB
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Bamako

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_csb
# XAMPP local uniquement. Ne jamais mettre de mot de passe réel dans ce fichier (versionné) : le mettre dans .env.
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Préfixe d'URL de l'administration (cahier §7 « URL dédiée ») : https://site/admin par défaut.
ADMIN_PATH=admin

# Destinataire des e-mails de notification des demandes (vide = e-mail de contact réglé dans l'administration).
# L'envoi réel exige un SMTP (MAIL_MAILER=smtp, MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD, MAIL_FROM_ADDRESS).
SITE_NOTIFICATION_EMAIL=

# Superadmins créés AUTOMATIQUEMENT s'ils n'existent pas (D27) : au lancement de `artisan serve`, après `migrate`, et à la première
# visite de la page de connexion. Laisser vide ici (fichier versionné) ; renseigner les vraies valeurs dans .env.
# Hors développement (APP_ENV != local), le mot de passe n'est que TEMPORAIRE : changement forcé à la première connexion.
# En hébergement, mettre un mot de passe FORT dans le .env du serveur.
SUPERADMIN_PASSWORD=
SUPERADMIN_1_NAME=
SUPERADMIN_1_PHONE=
SUPERADMIN_2_NAME=
SUPERADMIN_2_PHONE=

# Sauvegarde quotidienne (php artisan backup:run, planifiée) : XAMPP → /opt/lampp/bin/mysqldump.
# BACKUP_COPY_PATH : copie séparée (autre disque ou partage réseau), conseillée en production (cahier §22).
BACKUP_MYSQLDUMP=mysqldump
BACKUP_KEEP=30
BACKUP_COPY_PATH=

# Alertes WhatsApp à l'équipe (WhatsApp Business Cloud API de Meta) : jeton et identifiant du numéro fournis par Meta,
# modèle de message approuvé (un paramètre de texte). Vide : alertes désactivées. Destinataires : Paramètres → WhatsApp.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=csb_alerte
WHATSAPP_TEMPLATE_LANGUAGE=fr

# Notifications push à l'équipe (nouveau ticket…) : php artisan push:keys ; vides = désactivées
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Proxy HTTPS ou tunnel (ngrok) devant le site : * ou adresses séparées par des virgules ; vide = aucun
TRUSTED_PROXIES=
